{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orgward:closed-loop:19",
  "title": "Proposed portable payload schemas; inherit canonical aggregate scope and authority; not runtime implementation",
  "$defs": {
    "VersionRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "revision",
        "kind"
      ],
      "additionalProperties": false
    },
    "EvidenceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/VersionRef"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "artifact",
        "digest",
        "locator"
      ],
      "additionalProperties": false
    },
    "Provenance": {
      "type": "object",
      "properties": {
