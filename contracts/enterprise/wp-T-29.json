    "authoritative": true,
    "tenantBoundary": "Session-derived tenant/workspace; composite references and tenant-leading indices. A payload target tenant is a checked selector only.",
    "indices": [
      "UNIQUE (tenant_id, operation, command_id)",
      "(tenant_id, aggregate_id, version)",
      "(tenant_id, workspace_id, state, updated_at, id)"
    ],
